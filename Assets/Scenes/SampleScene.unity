--- !u!102 &1062647797
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1062647795}
  m_Text: 'Go to Karaoke with Maura:

    This minigame is justlike Guitar Hero.

    There
    will be 3 buttons you have to press:

    i : For red.

    j : For green

    n
    : For blue

    Press them when they are on top of

    the black circle. Hold
    the buttons

    when the fire trail comes,

    and release when it finishes.'
  m_OffsetZ: 0
  m_CharacterSize: 0.3
  m_LineSpacing: 1
  m_Anchor: 0
