TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 672599868}
  m_Text: 'Ngan has something to tell you,

    but she has been really nervous

    to
    say it. Whenever she sees

    you getting close, she

    screams of nervoursness.

    Try
    to approach her while she

    is not looking.'
